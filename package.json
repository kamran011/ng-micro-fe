{
  "name": "ng-micro-fe",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n shell,cockpit,studio,telemetry -c cyan,green,yellow,magenta \"ng serve shell\" \"ng serve cockpit\" \"ng serve studio\" \"ng serve telemetry\"",
    "build": "npm run build:remotes && ng build shell",
    "watch": "ng build --watch --configuration development",
    "test": "ng test shell && ng test cockpit && ng test studio && ng test telemetry",
    "build:remotes": "ng build cockpit && ng build studio && ng build telemetry",
    "e2e": "playwright test",
    "storybook": "ng run design-system:storybook",
    "build-storybook": "ng run design-system:build-storybook"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/localize": "^22.2.4",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@ngrx/signals": "^22.0.1",
    "echarts": "^6.1.0",
    "es-module-shims": "^2.8.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-architects/native-federation": "^22.2.4",
    "@angular-devkit/architect": "^0.2202.6",
    "@angular-devkit/build-angular": "^22.2.6",
    "@angular-devkit/core": "^22.2.6",
    "@angular/animations": "^22.2.4",
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@softarc/native-federation-orchestrator": "^4.8.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/angular": "^10.6.6",
    "concurrently": "^10.0.6",
    "es-module-shims": "^2.8.4",
    "jsdom": "^30.0.0",
    "material-symbols": "^0.48.3",
    "prettier": "^3.8.1",
    "storybook": "^10.6.6",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "zone.js": "^0.16.3"
  }
}